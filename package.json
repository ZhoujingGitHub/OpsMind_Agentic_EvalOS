{
  "name": "opsmind-agentic-evalos",
  "version": "0.3.1-m31",
  "private": true,
  "type": "module",
  "engines": { "node": ">=24.0.0" },
  "scripts": {
    "test": "node --test packages/kernel/test/*.test.mjs packages/twin-runtime/test/*.test.mjs packages/agent-runtime/test/*.test.mjs services/control-api/test/*.test.mjs",
    "api": "node services/control-api/src/server.mjs",
    "adapter:check": "node packages/agent-runtime/scripts/check-adapter.mjs",
    "architecture:m31": "node scripts/check-m31-architecture.mjs",
    "security:m31": "node scripts/check-m31-security.mjs",
    "capabilities:m31": "node scripts/check-m31-capability-protection.mjs",
    "freeze:sources:m31": "node scripts/freeze-m31-source-snapshots.mjs",
    "console:lint": "npm --prefix apps/console run lint",
    "console:build": "npm --prefix apps/console run build",
    "console:test": "npm --prefix apps/console test",
    "m31:verify": "npm test && npm run adapter:check && npm run capabilities:m31 && npm run architecture:m31 && npm run security:m31 && npm run console:lint && npm run console:test && npm run console:build"
  }
}
