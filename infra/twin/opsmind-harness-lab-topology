#!/bin/sh
set -eu

STATE_ROOT=/run/opsmind-harness-lab
HTTP_PID="$STATE_ROOT/http.pid"
MQTT_PID="$STATE_ROOT/mqtt.pid"
DNS_PID="$STATE_ROOT/dns.pid"
command=${1:-}
scenario=${2:-}
network=$(python3 - <<'PY'
import ipaddress, json
from pathlib import Path
n = json.loads(Path("/etc/opsmind-twin/stack.manifest.json").read_text())["harness_network"]
print(ipaddress.ip_address(n["mec_address"]), ipaddress.ip_address(n["dns_address"]),
      ipaddress.ip_network(n["service_network"]), ipaddress.ip_network(n["ue_network"]))
PY
)
read -r MEC_IP DNS_IP SERVICE_NET UE_NET <<EOF
$network
EOF

stop_pid() {
  path="$1"
  if [ -f "$path" ]; then
    pid=$(cat "$path" 2>/dev/null || true)
    if [ -n "$pid" ]; then kill "$pid" 2>/dev/null || true; fi
    rm -f "$path"
  fi
}

delete_rule() {
  table="$1"
  shift
  while iptables -t "$table" -C "$@" >/dev/null 2>&1; do iptables -t "$table" -D "$@"; done
}

reset_topology() {
  stop_pid "$HTTP_PID"
  stop_pid "$MQTT_PID"
  stop_pid "$DNS_PID"
  ip route del "$SERVICE_NET" dev ah-host-a 2>/dev/null || true
  # Remove the former erroneous fallback only when its exact owner/interface matches.
  ip route del "$SERVICE_NET" dev opsminddn0 2>/dev/null || true
  delete_rule nat POSTROUTING -s "$UE_NET" -d "$SERVICE_NET" -o ah-host-a -j ACCEPT
  delete_rule filter FORWARD -i ogstun -o ah-host-a -j ACCEPT
  delete_rule filter FORWARD -i ah-host-a -o ogstun -j ACCEPT
  for ns in opsmind-ah-mec opsmind-ah-c opsmind-ah-b opsmind-ah-a; do
    ip netns del "$ns" 2>/dev/null || true
  done
  ip link del ah-host-a 2>/dev/null || true
  # Check actual cleanup before the owning controller can release its lease.
  iptables -t nat -S POSTROUTING >/dev/null
  for ns in opsmind-ah-mec opsmind-ah-c opsmind-ah-b opsmind-ah-a; do
    if ip netns list | cut -d' ' -f1 | grep -qx "$ns"; then return 1; fi
  done
  if ip link show ah-host-a >/dev/null 2>&1; then return 1; fi
  if iptables -t nat -C POSTROUTING -s "$UE_NET" -d "$SERVICE_NET" -o ah-host-a -j ACCEPT >/dev/null 2>&1; then return 1; fi
}

up_all() {
  for ns in opsmind-ah-a opsmind-ah-b opsmind-ah-c opsmind-ah-mec; do
    ip netns add "$ns"
    ip -n "$ns" link set lo up
    ip netns exec "$ns" sysctl -q -w net.ipv4.ip_forward=1
  done

  ip link add ah-host-a type veth peer name ah-a-host
  ip link set ah-a-host netns opsmind-ah-a
  ip addr add 10.61.0.1/30 dev ah-host-a
  ip link set ah-host-a up
  ip -n opsmind-ah-a addr add 10.61.0.2/30 dev ah-a-host
  ip -n opsmind-ah-a link set ah-a-host up

  ip link add ah-a-b type veth peer name ah-b-a
  ip link set ah-a-b netns opsmind-ah-a
  ip link set ah-b-a netns opsmind-ah-b
  ip -n opsmind-ah-a addr add 10.61.0.5/30 dev ah-a-b
  ip -n opsmind-ah-b addr add 10.61.0.6/30 dev ah-b-a
  ip -n opsmind-ah-a link set ah-a-b up
  ip -n opsmind-ah-b link set ah-b-a up

  ip link add ah-b-c type veth peer name ah-c-b
  ip link set ah-b-c netns opsmind-ah-b
  ip link set ah-c-b netns opsmind-ah-c
  ip -n opsmind-ah-b addr add 10.61.0.9/30 dev ah-b-c
  ip -n opsmind-ah-c addr add 10.61.0.10/30 dev ah-c-b
  ip -n opsmind-ah-b link set ah-b-c up
  ip -n opsmind-ah-c link set ah-c-b up

  ip link add ah-c-mec type veth peer name ah-mec-c
  ip link set ah-c-mec netns opsmind-ah-c
  ip link set ah-mec-c netns opsmind-ah-mec
  ip -n opsmind-ah-c addr add 10.61.0.13/30 dev ah-c-mec
  ip -n opsmind-ah-mec addr add 10.61.0.14/30 dev ah-mec-c
  ip -n opsmind-ah-c link set ah-c-mec up
  ip -n opsmind-ah-mec link set ah-mec-c up
  ip -n opsmind-ah-mec addr add "$MEC_IP/32" dev lo
  ip -n opsmind-ah-mec addr add "$DNS_IP/32" dev lo

  ip -n opsmind-ah-a route add "$SERVICE_NET" via 10.61.0.6 dev ah-a-b
  ip -n opsmind-ah-b route add "$SERVICE_NET" via 10.61.0.10 dev ah-b-c
  ip -n opsmind-ah-c route add "$SERVICE_NET" via 10.61.0.14 dev ah-c-mec
  ip -n opsmind-ah-mec route add "$UE_NET" via 10.61.0.13 dev ah-mec-c
  ip -n opsmind-ah-c route add "$UE_NET" via 10.61.0.9 dev ah-c-b
  ip -n opsmind-ah-b route add "$UE_NET" via 10.61.0.5 dev ah-b-a
  ip -n opsmind-ah-a route add "$UE_NET" via 10.61.0.1 dev ah-a-host
  ip route replace "$SERVICE_NET" via 10.61.0.2 dev ah-host-a

  # Preserve UE source addresses only on the dedicated MEC path.
  # Filter-table fault gates still run before this NAT-table exception.
  iptables -t nat -I POSTROUTING 1 -s "$UE_NET" -d "$SERVICE_NET" -o ah-host-a -j ACCEPT

}

start_services() {
  mkdir -p "$STATE_ROOT"
  ip netns exec opsmind-ah-mec python3 /usr/local/libexec/opsmind-harness-mec-http.py \
    >>/var/log/opsmind-harness-mec-http-process.log 2>&1 &
  echo $! >"$HTTP_PID"
  ip netns exec opsmind-ah-mec mosquitto -c /etc/opsmind-harness-lab/mosquitto.conf \
    >>/var/log/opsmind-harness-mec-mqtt.log 2>&1 &
  echo $! >"$MQTT_PID"
  ip netns exec opsmind-ah-mec dnsmasq -C /etc/opsmind-harness-lab/dnsmasq.conf \
    >>/var/log/opsmind-harness-mec-dns.log 2>&1 &
  echo $! >"$DNS_PID"
}

# Transport faults live on hop B, the only transport node a candidate can read
# (node_profile=transport). Each is one command; the exam's answer key quotes it.
apply_fault() {
  case "$1" in
    n6-route-missing)
      ip route del "$SERVICE_NET" 2>/dev/null || true
      ;;
    transport-link-down)
      ip -n opsmind-ah-b link set ah-b-c down
      ;;
    transport-packet-loss)
      tc -n opsmind-ah-b qdisc add dev ah-b-c root netem loss 60%
      ;;
    transport-rate-limit)
      tc -n opsmind-ah-b qdisc add dev ah-b-c root tbf rate 16kbit burst 1600 latency 20ms
      ;;
    transport-route-loop)
      ip -n opsmind-ah-b route replace "$SERVICE_NET" via 10.61.0.5 dev ah-b-a
      ;;
  esac
}

# Restoring the path and clearing an impairment are different repairs. A
# candidate that picks the wrong one does not get the fault fixed for free.
restore_path() {
  ip -n opsmind-ah-b link set ah-b-c up
  ip -n opsmind-ah-b route replace "$SERVICE_NET" via 10.61.0.10 dev ah-b-c
  ip route replace "$SERVICE_NET" via 10.61.0.2 dev ah-host-a
}

clear_impairment() {
  tc -n opsmind-ah-b qdisc del dev ah-b-c root 2>/dev/null || true
}

transport_clean() {
  link_up=false
  if ip -n opsmind-ah-b -j link show ah-b-c | grep -q '"operstate":"UP"'; then link_up=true; fi
  impaired=false
  if tc -n opsmind-ah-b qdisc show dev ah-b-c | grep -Eq 'netem|tbf'; then impaired=true; fi
  path_ok=false
  if ip -n opsmind-ah-b route show "$SERVICE_NET" | grep -q "dev ah-b-c"; then path_ok=true; fi
  printf '%s %s %s' "$link_up" "$impaired" "$path_ok"
}

status() {
  ready=false
  if ip netns exec opsmind-ah-mec curl -fsS --max-time 2 "http://$MEC_IP:8080/health" >/dev/null 2>&1 && \
     ip netns exec opsmind-ah-mec mosquitto_pub -h "$MEC_IP" -p 1883 \
       -t opsmind/health -m ok -q 1 >/dev/null 2>&1 && \
     ip netns exec opsmind-ah-mec dig +time=1 +tries=1 +short @"$DNS_IP" opsmind-mec.lab A | grep -qx "$MEC_IP"; then
    ready=true
  fi
  route_present=false
  if ip route show "$SERVICE_NET" | grep -q ah-host-a; then route_present=true; fi
  read -r link_up impaired path_ok <<EOF
$(transport_clean 2>/dev/null || printf 'false false false')
EOF
  printf '{"ready":%s,"route_present":%s,"transport_link_up":%s,"transport_impaired":%s,"transport_path_ok":%s,"service_network":"%s","mec_ip":"%s","dns_ip":"%s","transport_hops":3,"http":8080,"mqtt":1883,"dns":53,"runtime_isolated":true}\n' \
    "$ready" "$route_present" "$link_up" "$impaired" "$path_ok" "$SERVICE_NET" "$MEC_IP" "$DNS_IP"
}

case "$command" in
  prepare)
    reset_topology
    up_all
    start_services
    apply_fault "$scenario"
    status
    ;;
  fault)
    apply_fault "${2:-}"
    status
    ;;
  restore-path)
    restore_path
    status
    ;;
  clear-impairment)
    clear_impairment
    status
    ;;
  status)
    status
    ;;
  reset)
    reset_topology
    printf '{"clean":true}\n'
    ;;
  *)
    echo "unsupported fixed topology operation" >&2
    exit 2
    ;;
esac
