[Unit]
Description=OpsMind Agentic EvalOS operator workbench
Wants=network-online.target
Requires=opsmind-evalos.service
After=network-online.target opsmind-evalos.service

[Service]
Type=simple
User=opsmindeval
Group=opsmindeval
WorkingDirectory=/opt/opsmind-evalos/current/evalos/apps/console
EnvironmentFile=-/etc/opsmind-evalos/evalos.env
Environment=CONSOLE_HOST=127.0.0.1
Environment=CONSOLE_PORT=3000
Environment=EVALOS_API_ORIGIN=http://127.0.0.1:8787
ExecStartPre=/bin/sh -c 'for attempt in $(/usr/bin/seq 1 60); do /usr/bin/curl --silent --fail --max-time 2 http://127.0.0.1:8787/health >/dev/null && exit 0; /usr/bin/sleep 1; done; exit 1'
ExecStart=/usr/local/bin/node serve.mjs
TimeoutStartSec=90
Restart=on-failure
RestartSec=3
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
RestrictSUIDSGID=true

[Install]
WantedBy=multi-user.target
