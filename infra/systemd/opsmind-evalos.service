[Unit]
Description=OpsMind Agentic EvalOS control API and investigation plane
Wants=network-online.target
After=network-online.target

[Service]
Type=simple
User=opsmindeval
Group=opsmindeval
WorkingDirectory=/opt/opsmind-evalos/current/evalos
EnvironmentFile=-/etc/opsmind/deepSeekParameter
EnvironmentFile=-/etc/opsmind-evalos/evalos.env
Environment=HOST=127.0.0.1
Environment=PORT=8787
Environment=EVALOS_DATABASE_PATH=/var/lib/opsmind-evalos/control/control.sqlite
Environment=EVALOS_PRIVATE_LABEL_DATABASE_PATH=/var/lib/opsmind-evalos/private/labels.sqlite
Environment=EVALOS_RUNTIME_ROOT=/var/lib/opsmind-evalos/runtime/control
Environment=EVALOS_ARTIFACTS_ROOT=/var/lib/opsmind-evalos/artifacts/m15
Environment=EVALOS_M2_ARTIFACTS_ROOT=/var/lib/opsmind-evalos/artifacts/m2
Environment=EVALOS_M2_EXECUTOR_ARTIFACTS_ROOT=/var/lib/opsmind-evalos/artifacts/m2-executor
Environment=EVALOS_M2_AGENT_ARTIFACTS_ROOT=/var/lib/opsmind-evalos/artifacts/m2-agent
Environment=EVALOS_M2_QUALIFICATION_ARTIFACTS_ROOT=/var/lib/opsmind-evalos/artifacts/m2-qualification
Environment=EVALOS_ALLOWED_ORIGIN=https://121-40-223-202.sslip.io
Environment=EVALOS_TWIN_HOST=114.215.189.185
Environment=EVALOS_TWIN_USER=evalos-twin
Environment=EVALOS_TWIN_SSH_KEY=/etc/opsmind-evalos/keys/m2-twin-ed25519
Environment=EVALOS_TWIN_KNOWN_HOSTS=/etc/opsmind-evalos/keys/m2-twin-known_hosts
Environment=EVALOS_TWIN_USE_SUDO=1
Environment=EVALOS_CANDIDATE_OBSERVATION_IDENTITIES=/etc/opsmind-evalos/candidate-observation-identities.json
ExecStart=/usr/local/bin/node services/control-api/src/server.mjs
Restart=on-failure
RestartSec=3
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/var/lib/opsmind-evalos
RestrictSUIDSGID=true

[Install]
WantedBy=multi-user.target
