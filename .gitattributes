# Every tracked text file is LF in the index and in the working tree, on every
# build host: release payloads are hashed, and a CRLF checkout would change the
# bytes without changing the commit.
* text=auto eol=lf
*.docx binary
*.doc binary
*.pdf binary
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.pptx binary
*.xlsx binary
*.zip binary
*.gz binary
*.pcap binary
*.sqlite binary
infra/twin/*.py text eol=lf
*.sh text eol=lf
*.service text eol=lf
*.conf text eol=lf
# Controller release payload must hash identically on every build host.
infra/twin/*.json text eol=lf
infra/twin/config/*.yaml text eol=lf
infra/twin/opsmind-harness-lab-topology text eol=lf
infra/twin/opsmind-harness-ssh-shim text eol=lf
infra/twin/opsmind-langgraph-lab-topology text eol=lf
infra/twin/opsmind-langgraph-ssh-shim text eol=lf
