{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://opsmind.local/contracts/experiment-manifest-v8.schema.json",
  "title": "OpsMind EvalOS Experiment Manifest 8.0",
  "description": "为每套外部架构分别冻结多维 Candidate 预算、最终结算保留量、执行口径与证据来源；禁止按 Case 或 Seed 定预算。",
  "type": "object",
  "required": ["manifest_version", "milestone", "run_class", "evaluation_mode", "evaluation_lane", "operating_modes", "execution_mode", "approval_oracle", "design", "name", "suite_ref", "dataset_ref", "case_refs", "case_partitions", "environment_seeds", "replicates_per_seed", "contestants", "model", "candidate_runtime_policy", "candidate_budget_contract", "frozen_dependencies", "policy", "retry_policy", "capacity_policy", "statistics_policy"],
  "properties": {
    "manifest_version": { "const": "8.0" },
    "milestone": { "const": "M3.2" },
    "run_class": { "const": "REAL_CANDIDATE" },
    "evaluation_mode": { "enum": ["QUALIFICATION", "CAPACITY_REHEARSAL", "FORMAL"] },
    "evaluation_lane": { "enum": ["AGENT_CAPABILITY", "CONTROLLED_CLOSURE", "PRODUCT_RELIABILITY"] },
    "operating_modes": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "enum": ["diagnosis_only", "human_collaboration", "controlled_auto"] } },
    "execution_mode": { "enum": ["controlled_simulation", "replay_read_only"] },
    "approval_oracle": { "type": "object" },
    "design": { "enum": ["single_system_acceptance", "paired_comparison"] },
    "name": { "type": "string", "minLength": 1 },
    "suite_ref": { "type": "string", "minLength": 1 },
    "dataset_ref": { "type": "string", "minLength": 1 },
    "case_refs": { "$ref": "#/$defs/strings" },
    "case_partitions": { "type": "object" },
    "environment_seeds": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "integer" } },
    "replicates_per_seed": { "type": "integer", "minimum": 1 },
    "contestants": { "type": "array", "minItems": 1, "maxItems": 2, "items": { "$ref": "#/$defs/contestant" } },
    "model": { "type": "object" },
    "candidate_runtime_policy": { "type": "object" },
    "candidate_budget_contract": { "$ref": "#/$defs/candidateBudgetContract" },
    "frozen_dependencies": { "type": "object" },
    "policy": { "type": "object" },
    "retry_policy": { "type": "object" },
    "capacity_policy": { "type": "object" },
    "statistics_policy": {
      "type": "object",
      "required": ["comparison_design", "confidence_level", "cluster_by_case", "report_failures", "per_architecture_calibration"],
      "properties": {
        "comparison_design": { "enum": ["independent_stratified", "paired_case_control"] },
        "confidence_level": { "const": 0.95 },
        "cluster_by_case": { "const": true },
        "report_failures": { "const": true },
        "per_architecture_calibration": { "const": true }
      },
      "additionalProperties": false
    },
    "source_experiment_id": { "type": "string" },
    "request_kind": { "type": "string" },
    "evaluation_purpose": { "type": "string" },
    "operator_reason": { "type": "string" }
  },
  "$defs": {
    "digest": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
    "strings": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
    "budget": {
      "type": "object",
      "required": ["input_tokens", "output_tokens", "model_calls", "tool_calls", "wallclock_ms", "compute_ms", "storage_bytes", "cost_usd"],
      "properties": {
        "input_tokens": { "type": "number", "exclusiveMinimum": 0 },
        "output_tokens": { "type": "number", "exclusiveMinimum": 0 },
        "model_calls": { "type": "number", "exclusiveMinimum": 0 },
        "tool_calls": { "type": "number", "exclusiveMinimum": 0 },
        "wallclock_ms": { "type": "number", "exclusiveMinimum": 0 },
        "compute_ms": { "type": "number", "exclusiveMinimum": 0 },
        "storage_bytes": { "type": "number", "exclusiveMinimum": 0 },
        "cost_usd": { "type": "number", "exclusiveMinimum": 0 }
      },
      "additionalProperties": false
    },
    "candidateNativeBudget": {
      "type": "object",
      "required": ["max_duration_seconds", "max_model_calls", "max_tool_calls", "max_tokens", "max_cost_microunits", "max_result_bytes"],
      "properties": {
        "max_duration_seconds": { "type": "number", "exclusiveMinimum": 0 },
        "max_model_calls": { "type": "number", "exclusiveMinimum": 0 },
        "max_tool_calls": { "type": "number", "exclusiveMinimum": 0 },
        "max_tokens": { "type": "number", "exclusiveMinimum": 0 },
        "max_cost_microunits": { "type": "number", "exclusiveMinimum": 0 },
        "max_result_bytes": { "type": "number", "exclusiveMinimum": 0 }
      },
      "additionalProperties": false
    },
    "enforcement": {
      "type": "object",
      "required": ["max_duration_seconds", "max_model_calls", "max_tool_calls", "max_tokens", "max_cost_microunits", "max_result_bytes"],
      "properties": {
        "max_duration_seconds": { "$ref": "#/$defs/enforcementMode" },
        "max_model_calls": { "$ref": "#/$defs/enforcementMode" },
        "max_tool_calls": { "$ref": "#/$defs/enforcementMode" },
        "max_tokens": { "$ref": "#/$defs/enforcementMode" },
        "max_cost_microunits": { "$ref": "#/$defs/enforcementMode" },
        "max_result_bytes": { "$ref": "#/$defs/enforcementMode" }
      },
      "additionalProperties": false
    },
    "enforcementMode": { "enum": ["enforced", "observed_only", "not_observable"] },
    "provenance": {
      "type": "object",
      "required": ["status", "method", "source_revision", "artifact_digest", "sample_trial_ids", "evidence_ref"],
      "properties": {
        "status": { "enum": ["product_native_baseline", "empirical_calibrated"] },
        "method": { "type": "string", "minLength": 1 },
        "source_revision": { "type": "string", "minLength": 7 },
        "artifact_digest": { "$ref": "#/$defs/digest" },
        "sample_trial_ids": { "type": "array", "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
        "evidence_ref": { "type": "string", "minLength": 1 }
      },
      "additionalProperties": false
    },
    "budgetProfile": {
      "type": "object",
      "required": ["contestant_ref", "candidate_limits", "settlement_limits", "enforcement", "provenance"],
      "properties": {
        "contestant_ref": { "type": "string", "minLength": 1 },
        "candidate_limits": { "$ref": "#/$defs/candidateNativeBudget" },
        "settlement_limits": { "$ref": "#/$defs/budget" },
        "enforcement": { "$ref": "#/$defs/enforcement" },
        "provenance": { "$ref": "#/$defs/provenance" }
      },
      "additionalProperties": false
    },
    "candidateBudgetContract": {
      "type": "object",
      "required": ["contract_version", "phase", "joint_envelope_policy", "profiles"],
      "properties": {
        "contract_version": { "const": "evalos-candidate-budget-profile/1.0" },
        "phase": { "enum": ["CALIBRATION", "QUALIFICATION", "CAPACITY", "FORMAL"] },
        "joint_envelope_policy": {
          "type": "object",
          "required": ["method", "target_coverage", "holdout_required", "case_specific_limits_forbidden"],
          "properties": {
            "method": { "const": "whole_trial_multidimensional_envelope" },
            "target_coverage": { "type": "number", "exclusiveMinimum": 0, "exclusiveMaximum": 1 },
            "holdout_required": { "const": true },
            "case_specific_limits_forbidden": { "const": true }
          },
          "additionalProperties": false
        },
        "profiles": { "type": "array", "minItems": 1, "maxItems": 2, "items": { "$ref": "#/$defs/budgetProfile" } }
      },
      "additionalProperties": false
    },
    "contestant": {
      "type": "object",
      "required": ["ref", "kind", "architecture", "adapter_contract_version", "adapter_version", "source_revision", "artifact_digest", "runtime_digest", "runtime_manifest_digest", "capability_contract_digest", "binding_requirement", "candidate_runtime"],
      "properties": {
        "ref": { "type": "string", "minLength": 1 },
        "kind": { "const": "REAL_PRODUCT" },
        "architecture": { "type": "string", "minLength": 1 },
        "adapter_contract_version": { "const": "5.0" },
        "adapter_version": { "const": "candidate-adapter-5.0.0" },
        "source_revision": { "type": "string", "minLength": 7 },
        "artifact_digest": { "$ref": "#/$defs/digest" },
        "runtime_digest": { "$ref": "#/$defs/digest" },
        "runtime_manifest_digest": { "$ref": "#/$defs/digest" },
        "capability_contract_digest": { "$ref": "#/$defs/digest" },
        "binding_requirement": { "enum": ["PRODUCT_NATIVE_ACK", "EVIDENCE_CHAIN_BOUND"] },
        "candidate_runtime": { "type": "object" }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
