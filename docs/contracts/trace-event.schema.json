{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://opsmind.local/contracts/trace-event.schema.json",
  "title": "OpsMind EvalOS Trace Event",
  "type": "object",
  "required": ["event_id", "trial_id", "seq", "timestamp", "kind", "actor", "payload", "payload_hash", "redacted"],
  "properties": {
    "event_id": { "type": "string" },
    "trial_id": { "type": "string" },
    "seq": { "type": "integer", "minimum": 1 },
    "timestamp": { "type": "string", "format": "date-time" },
    "kind": { "type": "string" },
    "actor": { "type": "string" },
    "payload": { "type": "object" },
    "payload_hash": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "redacted": { "type": "boolean" }
  },
  "additionalProperties": false
}

