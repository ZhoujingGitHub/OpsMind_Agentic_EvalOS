{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://opsmind.local/contracts/experiment-manifest-v7.schema.json",
  "title": "OpsMind EvalOS Experiment Manifest 7.0",
  "description": "在 Manifest 6.0 旁路新增的真实产品合同。EvalOS 自身仍冻结 Claude Agent SDK + DeepSeek V4 Flash；每个外部产品另行冻结其公开原生模型组合和版本。",
  "type": "object",
  "required": ["manifest_version", "milestone", "run_class", "evaluation_mode", "evaluation_lane", "operating_modes", "execution_mode", "approval_oracle", "design", "name", "suite_ref", "dataset_ref", "case_refs", "case_partitions", "environment_seeds", "replicates_per_seed", "contestants", "model", "candidate_runtime_policy", "frozen_dependencies", "budget", "policy", "retry_policy", "capacity_policy", "statistics_policy"],
  "properties": {
    "manifest_version": { "const": "7.0" }, "milestone": { "const": "M3.2" },
    "run_class": { "const": "REAL_CANDIDATE" },
    "evaluation_mode": { "enum": ["QUALIFICATION", "CAPACITY_REHEARSAL", "FORMAL"] },
    "evaluation_lane": { "enum": ["AGENT_CAPABILITY", "CONTROLLED_CLOSURE", "PRODUCT_RELIABILITY"] },
    "operating_modes": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "enum": ["diagnosis_only", "human_collaboration", "controlled_auto"] } },
    "execution_mode": { "enum": ["controlled_simulation", "replay_read_only"] },
    "approval_oracle": { "$ref": "#/$defs/approvalOracle" },
    "design": { "enum": ["single_system_acceptance", "paired_comparison"] },
    "name": { "type": "string", "minLength": 1 }, "suite_ref": { "type": "string", "minLength": 1 },
    "dataset_ref": { "type": "string", "minLength": 1 },
    "case_refs": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
    "case_partitions": { "type": "object", "required": ["public", "hidden", "safety", "regression"],
      "properties": { "public": { "$ref": "#/$defs/strings" }, "hidden": { "$ref": "#/$defs/strings" },
        "safety": { "$ref": "#/$defs/strings" }, "regression": { "$ref": "#/$defs/strings" } },
      "additionalProperties": false },
    "environment_seeds": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "integer" } },
    "replicates_per_seed": { "type": "integer", "minimum": 1 },
    "contestants": { "type": "array", "minItems": 1, "maxItems": 2, "items": { "$ref": "#/$defs/contestant" } },
    "model": { "$ref": "#/$defs/evalosModel" },
    "candidate_runtime_policy": {
      "type": "object", "required": ["source", "allow_multi_model", "hidden_case_fields", "usage_accounting"],
      "properties": { "source": { "const": "candidate_public_api" }, "allow_multi_model": { "const": true },
        "hidden_case_fields": { "const": "opaque_digest_only" },
        "usage_accounting": { "const": "reported_with_explicit_unknowns" } }, "additionalProperties": false
    },
    "frozen_dependencies": { "$ref": "#/$defs/dependencies" }, "budget": { "$ref": "#/$defs/budget" },
    "policy": { "type": "object" }, "retry_policy": { "type": "object" },
    "capacity_policy": { "type": "object" }, "statistics_policy": { "type": "object" },
    "source_experiment_id": { "type": "string" }, "request_kind": { "type": "string" },
    "evaluation_purpose": { "type": "string" }, "operator_reason": { "type": "string" }
  },
  "$defs": {
    "digest": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
    "strings": { "type": "array", "uniqueItems": true, "items": { "type": "string" } },
    "approvalOracle": { "type": "object", "required": ["ref", "digest", "decision_source", "timeout_ms", "separation_of_duties"],
      "properties": { "ref": { "type": "string" }, "digest": { "$ref": "#/$defs/digest" },
        "decision_source": { "const": "frozen_case_contract" }, "timeout_ms": { "type": "integer", "minimum": 1000 },
        "separation_of_duties": { "const": true } }, "additionalProperties": false },
    "modelProfile": { "type": "object", "required": ["provider", "id", "interface", "thinking", "roles"],
      "properties": { "provider": { "type": "string" }, "id": { "type": "string" }, "interface": { "type": "string" },
        "thinking": { "enum": ["enabled", "disabled", "unknown"] }, "roles": { "$ref": "#/$defs/strings" } },
      "additionalProperties": false },
    "candidateRuntime": { "type": "object", "required": ["contract_version", "models", "versions"],
      "properties": { "contract_version": { "const": "1.0" },
        "models": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/modelProfile" } },
        "versions": { "type": "object", "additionalProperties": { "type": "string", "minLength": 1 } } },
      "additionalProperties": false },
    "contestant": { "type": "object", "required": ["ref", "kind", "architecture", "adapter_contract_version", "adapter_version", "source_revision", "artifact_digest", "runtime_digest", "runtime_manifest_digest", "capability_contract_digest", "binding_requirement", "candidate_runtime"],
      "properties": { "ref": { "type": "string" }, "kind": { "const": "REAL_PRODUCT" },
        "architecture": { "type": "string" }, "adapter_contract_version": { "const": "5.0" },
        "adapter_version": { "const": "candidate-adapter-5.0.0" }, "source_revision": { "type": "string", "minLength": 7 },
        "artifact_digest": { "$ref": "#/$defs/digest" }, "runtime_digest": { "$ref": "#/$defs/digest" },
        "runtime_manifest_digest": { "$ref": "#/$defs/digest" }, "capability_contract_digest": { "$ref": "#/$defs/digest" },
        "binding_requirement": { "enum": ["PRODUCT_NATIVE_ACK", "EVIDENCE_CHAIN_BOUND"] },
        "candidate_runtime": { "$ref": "#/$defs/candidateRuntime" } }, "additionalProperties": false },
    "evalosModel": { "type": "object", "required": ["provider", "id", "interface", "sdk", "thinking", "temperature", "max_turns"],
      "properties": { "provider": { "const": "deepseek" }, "id": { "const": "deepseek-v4-flash" },
        "interface": { "const": "anthropic" }, "sdk": { "const": "@anthropic-ai/claude-agent-sdk" },
        "thinking": { "enum": ["enabled", "disabled"] }, "temperature": { "type": "number" },
        "max_turns": { "type": "integer", "minimum": 1 } }, "additionalProperties": false },
    "versionedArtifact": { "type": "object", "required": ["ref", "digest"],
      "properties": { "ref": { "type": "string" }, "digest": { "$ref": "#/$defs/digest" } }, "additionalProperties": false },
    "dependencies": { "type": "object", "required": ["mcp_catalog", "agent_harness_skill_pack", "langgraph_knowledge_pack", "scope_policy", "grader", "twin", "trace_schema", "product_adapter_contract"],
      "properties": { "mcp_catalog": { "$ref": "#/$defs/versionedArtifact" }, "agent_harness_skill_pack": { "$ref": "#/$defs/versionedArtifact" },
        "langgraph_knowledge_pack": { "$ref": "#/$defs/versionedArtifact" }, "scope_policy": { "$ref": "#/$defs/versionedArtifact" },
        "grader": { "$ref": "#/$defs/versionedArtifact" }, "twin": { "$ref": "#/$defs/versionedArtifact" },
        "trace_schema": { "$ref": "#/$defs/versionedArtifact" }, "product_adapter_contract": { "$ref": "#/$defs/versionedArtifact" } },
      "additionalProperties": false },
    "budget": { "type": "object", "required": ["input_tokens", "output_tokens", "model_calls", "tool_calls", "wallclock_ms", "compute_ms", "storage_bytes", "cost_usd"],
      "properties": { "input_tokens": { "type": "number", "exclusiveMinimum": 0 }, "output_tokens": { "type": "number", "exclusiveMinimum": 0 },
        "model_calls": { "type": "number", "exclusiveMinimum": 0 }, "tool_calls": { "type": "number", "exclusiveMinimum": 0 },
        "wallclock_ms": { "type": "number", "exclusiveMinimum": 0 }, "compute_ms": { "type": "number", "exclusiveMinimum": 0 },
        "storage_bytes": { "type": "number", "exclusiveMinimum": 0 }, "cost_usd": { "type": "number", "exclusiveMinimum": 0 } },
      "additionalProperties": false }
  },
  "allOf": [
    { "if": { "properties": { "design": { "const": "single_system_acceptance" } } }, "then": { "properties": { "contestants": { "maxItems": 1 } } } },
    { "if": { "properties": { "design": { "const": "paired_comparison" } } }, "then": { "properties": { "contestants": { "minItems": 2 } } } }
  ],
  "additionalProperties": false
}
