{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://opsmind.local/contracts/candidate-adapter-v3.schema.json",
  "title": "OpsMind EvalOS Candidate Adapter Contract 3.0",
  "description": "EvalOS交给外部真实考生的统一准考证。Adapter只提交任务、翻译公开事件和收集原始证据，不替考生调用内部工具。",
  "type": "object",
  "required": ["adapter_contract_version", "evaluation_lane", "run_class", "operating_modes", "execution_mode", "experiment_id", "trial", "contestant", "case", "scope", "tools", "model", "frozen_dependencies", "budget", "policy", "approval_oracle", "retry_policy", "contract_digest"],
  "properties": {
    "adapter_contract_version": { "const": "3.0" },
    "evaluation_lane": { "enum": ["AGENT_CAPABILITY", "CONTROLLED_CLOSURE", "PRODUCT_RELIABILITY"] },
    "run_class": { "const": "REAL_CANDIDATE" },
    "operating_modes": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "enum": ["diagnosis_only", "human_collaboration", "controlled_auto"] } },
    "execution_mode": { "enum": ["controlled_simulation", "replay_read_only"] },
    "experiment_id": { "type": "string", "minLength": 1 },
    "trial": {
      "type": "object",
      "required": ["id", "case_ref", "environment_seed", "replicate_id", "blind_id"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "case_ref": { "type": "string", "minLength": 1 },
        "environment_seed": { "type": "integer" },
        "replicate_id": { "type": "integer", "minimum": 1 },
        "blind_id": { "type": "string", "minLength": 1 }
      },
      "additionalProperties": false
    },
    "contestant": {
      "type": "object",
      "required": ["ref", "adapter_version", "source_revision", "artifact_digest", "runtime_digest", "runtime_manifest_digest", "capability_contract_digest", "kind", "architecture"],
      "properties": {
        "ref": { "type": "string", "minLength": 1 },
        "adapter_version": { "type": "string", "minLength": 1 },
        "source_revision": { "type": "string", "minLength": 7 },
        "artifact_digest": { "$ref": "#/$defs/digest" },
        "runtime_digest": { "$ref": "#/$defs/digest" },
        "runtime_manifest_digest": { "$ref": "#/$defs/digest" },
        "capability_contract_digest": { "$ref": "#/$defs/digest" },
        "kind": { "const": "REAL_PRODUCT" },
        "architecture": { "type": "string", "minLength": 1 }
      },
      "additionalProperties": false
    },
    "case": { "$ref": "case-contract-v3.schema.json" },
    "scope": { "type": "object" },
    "tools": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["name", "version", "description", "effect", "source_system", "input_schema", "output_schema"],
        "properties": {
          "name": { "type": "string" }, "version": { "type": "string" }, "description": { "type": "string" },
          "effect": { "enum": ["READ_ONLY", "CONTROLLED_WRITE"] }, "source_system": { "type": "string" },
          "input_schema": { "type": "object" }, "output_schema": { "type": "object" }
        },
        "additionalProperties": false
      }
    },
    "model": { "type": "object" },
    "frozen_dependencies": { "type": "object" },
    "budget": { "type": "object" },
    "policy": { "type": "object" },
    "approval_oracle": { "type": "object" },
    "retry_policy": { "type": "object" },
    "contract_digest": { "$ref": "#/$defs/digest" }
  },
  "$defs": { "digest": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" } },
  "additionalProperties": false
}
